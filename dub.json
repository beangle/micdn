{
  "name": "beangle-micdn",
  "version": "0.3.3",
  "description": "A minimal CDN.",
  "authors": ["chaostone"],
  "license": "GPLv3",
  "toolchainRequirements": {
    "dub": ">=1.34.0",
    "frontend": ">=2.102.0",
    "ldc": ">=1.32.0"
  },
  "dependencies": {
    "dxml": "~>0.4.5",
    "vibe-inet": "~>1.3.0",
    "vibe-http": "~>1.5.0",
    "vibe-stream:tls": "~>1.4.0"
  },
  "configurations": [
    {
      "name": "executable",
      "targetType": "executable",
      "targetPath": "target",
      "targetName": "micdn",
      "versions": ["EventCoreSilenceLeakWarnings"]
    },
    {
      "name": "executable-static",
      "targetType": "executable",
      "targetPath": "target",
      "targetName": "micdn",
      "versions": ["EventCoreSilenceLeakWarnings", "MicdnUseLibcurl"],
      "lflags": [
        "/usr/local/lib64/libcurl.a",
        "/usr/local/lib64/libssl.a",
        "/usr/local/lib64/libcrypto.a",
        "/usr/lib64/libz.a",
        "-ldl",
        "-lpthread",
        "-lrt",
        "-lm"
      ]
    },
    {
      "name": "unittest",
      "targetPath": "target",
      "sourcePaths": ["src", "test"],
      "importPaths": ["src", "test"],
      "dependencies": {
        "silly": "~>1.1.1"
      }
    }
  ],
  "subConfigurations": {
    "vibe-stream:tls": "notls"
  }
}
